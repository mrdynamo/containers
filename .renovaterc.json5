{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/.github:renovate-config"
  ],
  schedule: [
    "at any time"
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Process Annotations in Docker Bake",
      managerFilePatterns: ["/(^|/)docker-bake\\.hcl$/"],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+ = "(?:[^"@]+:)?(?<currentValue>[^"@:]+)(@(?<currentDigest>sha256:[a-f0-9]+))?"',
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    {
      customType: "regex",
      description: "Process Annotations in Dockerfiles",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],
  packageRules: [
    {
      description: ["Release Rules for App Updates"],
      addLabels: ["app/{{parentDir}}"],
      additionalBranchPrefix: "{{parentDir}}-",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
      commitMessageTopic: "{{depName}}",
      matchFileNames: ["**/docker-bake.hcl", "**/Dockerfile"],
      semanticCommitScope: "{{parentDir}}",
      semanticCommitType: "release",
    },
    {
      description: [
        "Never automerge extension updates: each release must be merged in the runbook order",
        "(the upgrade-rehearsal tests start from :rolling, which must equal what production runs).",
      ],
      matchFileNames: ["**/docker-bake.hcl"],
      automerge: false,
    },
    {
      description: [
        "Exempt App Updates from prHourlyLimit and create them last, since they still add to the hourly PR count",
      ],
      matchFileNames: [
        "apps/**"
      ],
      prHourlyLimit: 0,
      prPriority: -1,
    },
    {
      description: [
        "CNPG runtime image: tags like 18.6-standard-trixie need docker versioning",
        "(the bake manager defaults to semver, which can't parse them and only offers digests).",
      ],
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      versioning: "docker",
    },
    {
      description: [
        "CNPG runtime image: extensions are rebuilt only for new PostgreSQL minors.",
        "Majors need PG_MAJOR changed alongside; digest-only rebuilds (OS patches) don't change the ABI.",
      ],
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      matchUpdateTypes: ["major", "digest"],
      enabled: false,
    },
    {
      description: [
        "TimescaleDB: OLD_VERSION must equal the installed extversion and ALTER EXTENSION must be run after rollout.",
        "Require Dependency Dashboard approval.",
      ],
      matchDepNames: ["timescale/timescaledb"],
      dependencyDashboardApproval: true,
    },
    {
      description: ["TimescaleDB Toolkit: upstream re-tags fixed releases as X.Y.Z+pN"],
      matchDepNames: ["timescale/timescaledb-toolkit"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\+p(?<build>\\d+))?$",
    },
  ],
}
